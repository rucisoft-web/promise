APP_NAME="Promise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://promise.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=promise
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# produksi (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="promise@rucisoft.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Promise
PROMISE_BRAND_NAME="Promise"
# Situs demo: tombol "Masuk sebagai Tamu" (hanya lihat)
PROMISE_GUEST_LOGIN=false
PROMISE_GUEST_EMAIL=tamu@demo.promise.local
# Muat portofolio contoh (MedcoEnergi, data demo) walau APP_ENV=production
PROMISE_SEED_DEMO=false
# Tanggal status Earned Value (YYYY-MM-DD); kosong = hari ini
PROMISE_STATUS_DATE=
PROMISE_WHATSAPP=6281234567890
# Nama perusahaan yang tampil kecil di setiap halaman (bila tanpa data demo)
PROMISE_COMPANY_NAME=
# Akun admin awal saat `migrate --seed` (di produksi admin hanya dibuat bila sandi diisi)
PROMISE_ADMIN_EMAIL=admin@promise.local
PROMISE_ADMIN_PASSWORD=
